#!/usr/bin/env bash

# Stable launcher: prefer the compiled Go CLI and retain a Shell fallback while
# hosts transition to the Go toolchain.
set -euo pipefail

ASRL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ASRL_ROOT

if [[ -x "${ASRL_ROOT}/build/lab" ]]; then
    exec "${ASRL_ROOT}/build/lab" "$@"
fi

exec "${ASRL_ROOT}/scripts/lab-shell" "$@"
