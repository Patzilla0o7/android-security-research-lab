#!/usr/bin/env bash

# Stable launcher for the Go CLI. Build on first use when needed.
set -euo pipefail

ASRL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ASRL_ROOT

if [[ -x "${ASRL_ROOT}/build/lab" ]]; then
    exec "${ASRL_ROOT}/build/lab" "$@"
fi

if ! command -v go >/dev/null 2>&1; then
    echo "ASRL is not built and Go 1.22 or newer is not installed." >&2
    echo "Install Go, then run: ./scripts/build-go.sh" >&2
    exit 1
fi

"${ASRL_ROOT}/scripts/build-go.sh" >/dev/null
exec "${ASRL_ROOT}/build/lab" "$@"
